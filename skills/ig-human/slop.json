    {
      "id": "andiamo-a",
      "regex": "(?i)\\b(?:andiamo|andremo|vado|andrò|vai|andrai|andate) a (?:vedere|analizzare|scoprire|esplorare|approfondire|capire)\\b",
      "name": "\"Andiamo a vedere\" (giro di parole da presentazione)",
      "fix": "Di' direttamente la cosa: \"Ecco...\" oppure parti dal contenuto."
    },
    {
      "id": "coppie-locali",
      "regex": "(?i)\\b(?:tradizione e (?:innovazione|modernità)|passione e (?:dedizione|professionalità|competenza|amore)|qualità e (?:cortesia|professionalità|cortesia)|cortesia e professionalità|semplicità e (?:gusto|eleganza))\\b",
      "name": "Coppia di parole da brochure (\"tradizione e innovazione\", \"passione e professionalità\")",
