  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\" (inglese)",
      "fix": "Di' la cosa che intendi davvero. Cancella la metà che fa da premessa."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\" (inglese)",
      "fix": "Dividi in due frasi, o togli la metà più debole."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\" (inglese)",
      "fix": "Apri con Y. Il ribaltamento è il segnale."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "Riga con una domanda retorica di una parola (inglese)",
      "fix": "Rispondi subito invece di preparare la rivelazione."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\" (inglese)",
      "fix": "Di' la lezione. Salta l'annuncio."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Triade da regola del tre (inglese)",
      "fix": "Due elementi o quattro. Il tre è il ritmo di default del modello."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji razzo / fuoco / lampadina / scintille / bersaglio",
      "fix": "Al massimo un'emoji, e non una di queste cinque."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro di hashtag (5+)",
      "fix": "Al massimo cinque, specifici, in fondo. Il muro non porta più niente."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Il modello che parla di sé (inglese)",
      "fix": "Cancella la frase."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Apertura da conclusione di tema (inglese)",
      "fix": "Un post non ha bisogno del paragrafo di conclusione."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Esca da engagement di riflesso (inglese)",
      "fix": "Fai una domanda che potresti fare solo tu, sulla cosa precisa sopra."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b",
      "name": "Apertura \"stop scrolling\" (inglese)",
      "fix": "Il motivo per fermarsi deve essere l'affermazione stessa. Chiedere attenzione dimostra che non te la sei guadagnata."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:in (?:this|today'?s) (?:video|reel|post)|today i'?m going to show you|i'?m going to (?:show|teach) you how)\\b",
      "name": "Preambolo da video (inglese)",
      "fix": "Cancellalo e parti dal punto. I primi due secondi decidono tutto il reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
